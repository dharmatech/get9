#!/bin/rc

source_url=https://github.com/nooga/let-go.git
minimum_go=1.26

if(~ $#get9_root 0)
	get9_root=$home/lib/get9

get9_state=$home/lib/get9
pkgbase=$get9_root/pkg/let-go
work=$get9_root/tmp/let-go-main-$pid
source=$work/source
binary=$work/lg
stage=$pkgbase/.get9-stage-$pid
get9_profile=$get9_state/profile
get9_active=$get9_state/active/let-go.rc
userprofile=$home/lib/profile
profilebackup=$home/lib/profile.pre-get9
profiletmp=$work/profile
activetmp=$work/let-go.rc
userprofiletmp=$work/user-profile
get9_stage_owned=no

fn cleanup {
	if(test -d $work)
		rm -rf $work
	if(~ $get9_stage_owned yes && test -d $stage)
		rm -rf $stage
}

fn fail {
	echo get9: $* >[1=2]
	cleanup
	exit get9-install-failed
}

fn sigint {
	fail interrupted
}

fn write_get9_profile {
	{
		echo '# Generated by get9. Sources selected package activation scripts.'
		echo
		echo 'for(get9_activation in $home/lib/get9/active/*.rc) {'
		echo '	if(test -f $get9_activation)'
		echo '		. $get9_activation'
		echo '}'
		echo 'get9_activation=()'
	} >$profiletmp || fail could not write managed profile
	cp $profiletmp $get9_profile || fail could not install $get9_profile
}

fn select_let_go {
	{
		echo '# Generated by get9 for the selected LetGo source build.'
		echo
		echo 'get9_letgo_candidate_root='^$pkgroot
		echo 'get9_letgo_candidate_bin=$get9_letgo_candidate_root/bin'
		echo 'if(test -x $get9_letgo_candidate_bin/lg) {'
		echo '	if(! ~ $#get9_letgo_active_bin 0)'
		echo '		unmount $get9_letgo_active_bin /bin >[2]/dev/null'
		echo '	if(bind -b $get9_letgo_candidate_bin /bin) {'
		echo '		get9_letgo_active_root=$get9_letgo_candidate_root'
		echo '		get9_letgo_active_bin=$get9_letgo_candidate_bin'
		echo '	}'
		echo '	if not'
		echo '		echo get9: could not bind selected LetGo before /bin >[1=2]'
		echo '}'
		echo 'if not'
		echo '	echo get9: selected LetGo is missing from $get9_letgo_candidate_root >[1=2]'
		echo 'get9_letgo_candidate_root=()'
		echo 'get9_letgo_candidate_bin=()'
	} >$activetmp || fail could not write LetGo activation
	cp $activetmp $get9_active || fail could not select LetGo commit $source_commit
}

fn install_profile_hook {
	get9_profile_hooked=no
	if(test -f $userprofile) {
		if(grep -n '^# get9: profile hook$' $userprofile >/dev/null >[2]/dev/null)
			get9_profile_hooked=yes
	}

	if(~ $get9_profile_hooked no) {
		if(test -f $userprofile) {
			if(! test -e $profilebackup)
				cp -x $userprofile $profilebackup || fail could not back up $userprofile
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
				echo
				cat $userprofile
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		if not {
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		cp $userprofiletmp $userprofile || fail could not install profile hook
		echo get9: added the Get9 hook to $userprofile
	}
}

if(test -r $get9_profile)
	. $get9_profile

if(! ~ $cputype amd64)
	fail this LetGo source recipe supports only Plan 9 amd64

if(! test -x /bin/go) {
	echo get9: LetGo requires Go $minimum_go or newer >[1=2]
	echo get9: install it with: ports/go/1.27.0/binary/amd64/install.rc >[1=2]
	fail Go is not active in this installer namespace
}

go_version=`{go env GOVERSION}
go_os=`{go env GOOS}
go_arch=`{go env GOARCH}
if(! ~ $#go_version 1 && ~ $#go_os 1 && ~ $#go_arch 1)
	fail could not identify the active Go toolchain
if(! ~ $go_os plan9)
	fail the active Go toolchain targets $go_os instead of plan9
if(! ~ $go_arch amd64)
	fail the active Go toolchain targets $go_arch instead of amd64

get9_go_supported=no
if(~ $go_version go1.2[6-9]* go1.[3-9][0-9]* go[2-9].*)
	get9_go_supported=yes
if(~ $get9_go_supported no)
	fail LetGo requires Go $minimum_go or newer, but $go_version is active

if(~ $#SSL_CERT_FILE 0) {
	if(! test -r /sys/lib/tls/ca.pem) {
		echo get9: LetGo requires CA certificates for Go module downloads >[1=2]
		echo get9: install them with: ports/ca-certificates/2026-08-13/user/install.rc >[1=2]
		fail no readable CA certificate bundle is active
	}
}
if not {
	if(! test -r $SSL_CERT_FILE)
		fail SSL_CERT_FILE does not name a readable CA certificate bundle: $SSL_CERT_FILE
}

mkdir -p $pkgbase $get9_root/tmp $get9_root/cache/go $get9_root/cache/go-build $get9_state/active $home/lib ||
	fail could not create Get9 directories
mkdir $work || fail could not create temporary directory $work

if(! test -e /mnt/web/clone) {
	echo get9: starting webfs
	webfs || fail could not start webfs
}

echo get9: cloning $source_url
git/clone $source_url $source || fail could not clone LetGo

source_commit=`{cat $source/.git/refs/heads/main}
if(! ~ $#source_commit 1)
	fail could not resolve the cloned LetGo commit

pkgroot=$pkgbase/$source_commit
get9_already_installed=no
if(test -e $pkgroot) {
	if(! test -x $pkgroot/bin/lg)
		fail refusing to overwrite incomplete installation at $pkgroot
	get9_already_installed=yes
}

if(~ $get9_already_installed no) {
	if(test -e $stage)
		fail refusing to overwrite staging directory $stage

	GOPATH=$get9_root/cache/go
	GOCACHE=$get9_root/cache/go-build
	GOTOOLCHAIN=local

	echo get9: building LetGo commit $source_commit with $go_version
	@{cd $source && go build -o $binary .} || fail LetGo build failed
	test -x $binary || fail LetGo build did not produce an executable lg
	$binary -e '(+ 1 1)' >/dev/null || fail built LetGo executable did not run

	mkdir $stage || fail could not create staging directory $stage
	get9_stage_owned=yes
	mkdir $stage/bin || fail could not create staging bin directory
	mv $binary $stage/bin/lg || fail could not stage LetGo executable
	echo $source_url >$stage/source-url || fail could not record LetGo source URL
	echo $source_commit >$stage/source-commit || fail could not record LetGo source commit
	mv $stage $pkgroot || fail could not install LetGo at $pkgroot
	get9_stage_owned=no
}

write_get9_profile
select_let_go
install_profile_hook
cleanup

if(~ $get9_already_installed yes)
	echo get9: LetGo commit $source_commit is already installed at $pkgroot
if not
	echo get9: installed LetGo commit $source_commit at $pkgroot
echo get9: selected this LetGo build for future Drawterm connections
echo get9: reconnect with Drawterm to activate it everywhere
echo get9: to activate this window only, run: . $get9_profile
