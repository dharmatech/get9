# Dot-source this file to remove the selected LetGo binding from /bin.

if(~ $#get9_letgo_active_bin 0) {
	echo get9: no get9-managed LetGo build is active
}
if not {
	get9_letgo_old_bin=$get9_letgo_active_bin
	if(unmount $get9_letgo_old_bin /bin) {
		get9_letgo_active_root=()
		get9_letgo_active_bin=()
		echo get9: deactivated LetGo from $get9_letgo_old_bin
	}
	if not {
		echo get9: could not remove $get9_letgo_old_bin from /bin >[1=2]
	}
	get9_letgo_old_bin=()
}
