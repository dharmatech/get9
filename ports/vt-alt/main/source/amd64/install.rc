#!/bin/rc

source_url=https://github.com/dharmatech/vt-alt.git

if(~ $#get9_root 0)
	get9_root=$home/lib/get9

get9_state=$home/lib/get9
pkgbase=$get9_root/pkg/vt-alt
work=$get9_root/tmp/vt-alt-main-$pid
source=$work/source
binary=$source/6.out
smoke=$work/smoke
stage=$pkgbase/.get9-stage-$pid
get9_profile=$get9_state/profile
get9_active=$get9_state/active/vt-alt.rc
userprofile=$home/lib/profile
profilebackup=$home/lib/profile.pre-get9
profiletmp=$work/profile
activetmp=$work/vt-alt.rc
userprofiletmp=$work/user-profile
get9_stage_owned=no

fn cleanup {
	if(test -d $work)
		rm -rf $work
	if(~ $get9_stage_owned yes && test -d $stage)
		rm -rf $stage
}

fn fail {
	echo get9: $* >[1=2]
	cleanup
	exit get9-install-failed
}

fn sigint {
	fail interrupted
}

fn write_get9_profile {
	{
		echo '# Generated by get9. Sources selected package activation scripts.'
		echo
		echo 'for(get9_activation in $home/lib/get9/active/*.rc) {'
		echo '	if(test -f $get9_activation)'
		echo '		. $get9_activation'
		echo '}'
		echo 'get9_activation=()'
	} >$profiletmp || fail could not write managed profile
	cp $profiletmp $get9_profile || fail could not install $get9_profile
}

fn select_vt_alt {
	{
		echo '# Generated by get9 for the selected VT-Alt source build.'
		echo
		echo 'get9_vt_alt_candidate_root='^$pkgroot
		echo 'get9_vt_alt_candidate_bin=$get9_vt_alt_candidate_root/bin'
		echo 'if(test -x $get9_vt_alt_candidate_bin/vt-alt) {'
		echo '	if(! ~ $#get9_vt_alt_active_bin 0)'
		echo '		unmount $get9_vt_alt_active_bin /bin >[2]/dev/null'
		echo '	if(bind -b $get9_vt_alt_candidate_bin /bin) {'
		echo '		get9_vt_alt_active_root=$get9_vt_alt_candidate_root'
		echo '		get9_vt_alt_active_bin=$get9_vt_alt_candidate_bin'
		echo '	}'
		echo '	if not'
		echo '		echo get9: could not bind selected VT-Alt before /bin >[1=2]'
		echo '}'
		echo 'if not'
		echo '	echo get9: selected VT-Alt is missing from $get9_vt_alt_candidate_root >[1=2]'
		echo 'get9_vt_alt_candidate_root=()'
		echo 'get9_vt_alt_candidate_bin=()'
	} >$activetmp || fail could not write VT-Alt activation
	cp $activetmp $get9_active || fail could not select VT-Alt commit $source_commit
}

fn install_profile_hook {
	get9_profile_hooked=no
	if(test -f $userprofile) {
		if(grep -n '^# get9: profile hook$' $userprofile >/dev/null >[2]/dev/null)
			get9_profile_hooked=yes
	}

	if(~ $get9_profile_hooked no) {
		if(test -f $userprofile) {
			if(! test -e $profilebackup)
				cp -x $userprofile $profilebackup || fail could not back up $userprofile
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
				echo
				cat $userprofile
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		if not {
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		cp $userprofiletmp $userprofile || fail could not install profile hook
		echo get9: added the Get9 hook to $userprofile
	}
}

if(! ~ $cputype amd64)
	fail this VT-Alt source recipe supports only Plan 9 amd64

if(! test -x /bin/mk)
	fail VT-Alt requires the Plan 9 mk build tool
if(! test -r /sys/src/cmd/mkone)
	fail VT-Alt requires the standard Plan 9 build rules at /sys/src/cmd/mkone

mkdir -p $pkgbase $get9_root/tmp $get9_state/active $home/lib ||
	fail could not create Get9 directories
mkdir $work || fail could not create temporary directory $work

if(! test -e /mnt/web/clone) {
	echo get9: starting webfs
	webfs || fail could not start webfs
}

echo get9: cloning $source_url
git/clone $source_url $source || fail could not clone VT-Alt

source_commit=`{cat $source/.git/refs/remotes/origin/main}
if(! ~ $#source_commit 1)
	fail could not resolve the cloned VT-Alt main commit

head=`{cat $source/.git/HEAD}
checkout_commit=()
if(~ $#head 2) {
	if(~ $head(1) ref:)
		checkout_commit=`{cat $source/.git/$head(2)}
}
if not {
	if(~ $#head 1)
		checkout_commit=$head
}
if(! ~ $#checkout_commit 1)
	fail could not resolve the checked-out VT-Alt commit
if(! ~ $checkout_commit $source_commit)
	fail git9 checked out $checkout_commit instead of VT-Alt main $source_commit

pkgroot=$pkgbase/$source_commit
get9_already_installed=no
if(test -e $pkgroot) {
	if(! test -x $pkgroot/bin/vt-alt)
		fail refusing to overwrite incomplete installation at $pkgroot
	get9_already_installed=yes
}

if(~ $get9_already_installed no) {
	if(test -e $stage)
		fail refusing to overwrite staging directory $stage

	echo get9: building VT-Alt commit $source_commit
	@{cd $source && mk} || fail VT-Alt build failed
	test -x $binary || fail VT-Alt build did not produce an executable vt-alt
	if($binary -d >$smoke >[2=1])
		fail built VT-Alt unexpectedly accepted -d without -m
	if(! grep -n 'd requires -m' $smoke >/dev/null >[2]/dev/null)
		fail built VT-Alt did not pass its command-line smoke test

	mkdir $stage || fail could not create staging directory $stage
	get9_stage_owned=yes
	mkdir $stage/bin || fail could not create staging bin directory
	mv $binary $stage/bin/vt-alt || fail could not stage VT-Alt executable
	echo $source_url >$stage/source-url || fail could not record VT-Alt source URL
	echo $source_commit >$stage/source-commit || fail could not record VT-Alt source commit
	mv $stage $pkgroot || fail could not install VT-Alt at $pkgroot
	get9_stage_owned=no
}

write_get9_profile
select_vt_alt
install_profile_hook
cleanup

if(~ $get9_already_installed yes)
	echo get9: VT-Alt commit $source_commit is already installed at $pkgroot
if not
	echo get9: installed VT-Alt commit $source_commit at $pkgroot
echo get9: selected this VT-Alt build for future Drawterm connections
echo get9: reconnect with Drawterm to activate it everywhere
echo get9: to activate this window only, run: . $get9_profile
