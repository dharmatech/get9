# Dot-source this file to remove the Go binding installed by activate.rc.

if(~ $#get9_go_active_bin 0) {
	echo get9: no get9-managed Go version is active
}
if not {
	get9_go_old_bin=$get9_go_active_bin
	if(unmount $get9_go_old_bin /bin) {
		GOROOT=$get9_go_saved_goroot
		get9_go_active_root=()
		get9_go_active_bin=()
		get9_go_saved_goroot=()
		echo get9: deactivated Go from $get9_go_old_bin
	}
	if not {
		echo get9: could not remove $get9_go_old_bin from /bin >[1=2]
	}
	get9_go_old_bin=()
}
