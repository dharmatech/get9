#!/bin/rc

version=1.27.0
filename=go1.27.0.plan9-amd64.tar.gz
url=https://go.dev/dl/$filename
sha256=0035e7354a859052ce5be1eeda0f7163c50ac11bdf691e23ca0cb06faa6da811

if(~ $#get9_root 0)
	get9_root=$home/lib/get9

get9_state=$home/lib/get9
pkgbase=$get9_root/pkg/go
pkgroot=$pkgbase/$version
archive=$get9_root/distfiles/$filename
work=$get9_root/tmp/go-$version-$pid
download=$work/$filename
stage=$pkgbase/go
get9_profile=$get9_state/profile
get9_active=$get9_state/active/go.rc
userprofile=$home/lib/profile
profilebackup=$home/lib/profile.pre-get9
profiletmp=$work/profile
activetmp=$work/go.rc
userprofiletmp=$work/user-profile
get9_stage_owned=no

fn verify {
	get9_sum=`{sha1sum -2 256 $1}
	~ $#get9_sum 2 && ~ $get9_sum(1) $sha256
}

fn cleanup {
	if(test -d $work)
		rm -rf $work
	if(~ $get9_stage_owned yes && test -d $stage)
		rm -rf $stage
}

fn fail {
	echo get9: $* >[1=2]
	cleanup
	exit get9-install-failed
}

fn sigint {
	fail interrupted
}

fn write_get9_profile {
	{
		echo '# Generated by get9. Sources selected package activation scripts.'
		echo
		echo 'for(get9_activation in $home/lib/get9/active/*.rc) {'
		echo '	if(test -f $get9_activation)'
		echo '		. $get9_activation'
		echo '}'
		echo 'get9_activation=()'
	} >$profiletmp || fail could not write managed profile
	cp $profiletmp $get9_profile || fail could not install $get9_profile
}

fn select_go {
	{
		echo '# Generated by get9 for the selected Go version.'
		echo
		echo 'get9_go_candidate_root='^$pkgroot
		echo 'get9_go_candidate_bin=$get9_go_candidate_root/bin'
		echo 'if(test -x $get9_go_candidate_bin/go) {'
		echo '	if(~ $#get9_go_active_bin 0)'
		echo '		get9_go_saved_goroot=$GOROOT'
		echo '	if not'
		echo '		unmount $get9_go_active_bin /bin >[2]/dev/null'
		echo '	if(bind -b $get9_go_candidate_bin /bin) {'
		echo '		get9_go_active_root=$get9_go_candidate_root'
		echo '		get9_go_active_bin=$get9_go_candidate_bin'
		echo '		GOROOT=$get9_go_active_root'
		echo '	}'
		echo '	if not'
		echo '		echo get9: could not bind selected Go before /bin >[1=2]'
		echo '}'
		echo 'if not'
		echo '	echo get9: selected Go is missing from $get9_go_candidate_root >[1=2]'
		echo 'get9_go_candidate_root=()'
		echo 'get9_go_candidate_bin=()'
	} >$activetmp || fail could not write Go activation
	cp $activetmp $get9_active || fail could not select Go $version
}

fn install_profile_hook {
	get9_profile_hooked=no
	if(test -f $userprofile) {
		if(grep -n '^# get9: profile hook$' $userprofile >/dev/null >[2]/dev/null)
			get9_profile_hooked=yes
	}

	if(~ $get9_profile_hooked no) {
		if(test -f $userprofile) {
			if(! test -e $profilebackup)
				cp -x $userprofile $profilebackup || fail could not back up $userprofile
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
				echo
				cat $userprofile
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		if not {
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		cp $userprofiletmp $userprofile || fail could not install profile hook
		echo get9: added the Get9 hook to $userprofile
	}
}

if(test -e $pkgroot) {
	if(! test -x $pkgroot/bin/go)
		fail refusing to overwrite incomplete installation at $pkgroot
}

mkdir -p $get9_root/distfiles $pkgbase $get9_root/tmp $get9_state/active $home/lib ||
	fail could not create Get9 directories
mkdir $work || fail could not create temporary directory $work

get9_already_installed=no
if(test -x $pkgroot/bin/go)
	get9_already_installed=yes

if(~ $get9_already_installed no) {
	if(test -f $archive) {
		echo get9: using cached $archive
	}
	if not {
		if(! test -e /mnt/web/clone) {
			echo get9: starting webfs
			webfs || fail could not start webfs
		}

		echo get9: downloading $url
		hget $url >$download || fail download failed
		verify $download || fail downloaded archive has the wrong SHA-256 checksum
		mv $download $archive || fail could not cache downloaded archive
	}

	verify $archive || fail cached archive has the wrong SHA-256 checksum: $archive
	echo get9: verified SHA-256 $sha256

	if(test -e $stage)
		fail refusing to overwrite staging directory $stage

	get9_stage_owned=yes
	@{cd $pkgbase && tar xzf $archive} || fail could not extract $archive
	test -x $stage/bin/go || fail archive does not contain executable go/bin/go

	GOROOT=$stage $stage/bin/go version || fail extracted Go toolchain did not run
	mv $stage $pkgroot || fail could not install Go at $pkgroot
	get9_stage_owned=no
}

write_get9_profile
select_go
install_profile_hook
cleanup

if(~ $get9_already_installed yes)
	echo get9: Go $version is already installed at $pkgroot
if not
	echo get9: installed Go $version at $pkgroot
echo get9: selected Go $version for future Drawterm connections
echo get9: reconnect with Drawterm to activate it everywhere
echo get9: to activate this window only, run: . $get9_profile
