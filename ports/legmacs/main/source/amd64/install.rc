#!/bin/rc

source_url=https://github.com/nooga/legmacs.git

if(~ $#get9_root 0)
	get9_root=$home/lib/get9

get9_state=$home/lib/get9
pkgbase=$get9_root/pkg/legmacs
work=$get9_root/tmp/legmacs-main-$pid
source=$work/src
bundle=$work/legmacs.lgb
launcher=$work/legmacs
stage=$pkgbase/.get9-stage-$pid
get9_profile=$get9_state/profile
get9_active=$get9_state/active/legmacs.rc
userprofile=$home/lib/profile
profilebackup=$home/lib/profile.pre-get9
profiletmp=$work/profile
activetmp=$work/legmacs.rc
userprofiletmp=$work/user-profile
get9_stage_owned=no

fn cleanup {
	if(test -d $work)
		rm -rf $work
	if(~ $get9_stage_owned yes && test -d $stage)
		rm -rf $stage
}

fn fail {
	echo get9: $* >[1=2]
	cleanup
	exit get9-install-failed
}

fn sigint {
	fail interrupted
}

fn write_get9_profile {
	{
		echo '# Generated by get9. Sources selected package activation scripts.'
		echo
		echo 'for(get9_activation in $home/lib/get9/active/*.rc) {'
		echo '	if(test -f $get9_activation)'
		echo '		. $get9_activation'
		echo '}'
		echo 'get9_activation=()'
	} >$profiletmp || fail could not write managed profile
	cp $profiletmp $get9_profile || fail could not install $get9_profile
}

fn write_launcher {
	{
		echo '#!/bin/rc'
		echo '# Generated by Get9 as a Plan 9 adapter for the selected Legmacs source.'
		echo
		echo 'legmacs_root='^$pkgroot^'/src'
		echo 'if(! test -r $legmacs_root/main.lg) {'
		echo '	echo legmacs: installed source is missing from $legmacs_root >[1=2]'
		echo '	exit legmacs-source-missing'
		echo '}'
		echo 'if(! test -x /bin/lg) {'
		echo '	echo legmacs: lg is not active >[1=2]'
		echo '	exit legmacs-let-go-missing'
		echo '}'
		echo 'if(! test -x /bin/vt-alt) {'
		echo '	echo legmacs: vt-alt is not active >[1=2]'
		echo '	exit legmacs-vt-alt-missing'
		echo '}'
		echo 'if(~ $#LEGMACS_CONFIG_DIR 0)'
		echo '	legmacs_config_dir=$home/.config/legmacs'
		echo 'if not'
		echo '	legmacs_config_dir=$LEGMACS_CONFIG_DIR'
		echo 'legmacs_source_paths=($legmacs_root $legmacs_config_dir $LG_SOURCE_PATHS)'
		echo 'LG_SOURCE_PATHS=$legmacs_source_paths'
		echo 'legmacs_config_dir=()'
		echo 'legmacs_source_paths=()'
		echo 'exec vt-alt -bmdx -F bfc3cc lg $legmacs_root/main.lg $*'
	} >$launcher || fail could not write Legmacs launcher
	chmod +x $launcher || fail could not make Legmacs launcher executable
}

fn select_legmacs {
	{
		echo '# Generated by get9 for the selected Legmacs source installation.'
		echo
		echo 'get9_legmacs_candidate_root='^$pkgroot
		echo 'get9_legmacs_candidate_bin=$get9_legmacs_candidate_root/bin'
		echo 'if(test -x $get9_legmacs_candidate_bin/legmacs) {'
		echo '	if(! ~ $#get9_legmacs_active_bin 0)'
		echo '		unmount $get9_legmacs_active_bin /bin >[2]/dev/null'
		echo '	if(bind -b $get9_legmacs_candidate_bin /bin) {'
		echo '		get9_legmacs_active_root=$get9_legmacs_candidate_root'
		echo '		get9_legmacs_active_bin=$get9_legmacs_candidate_bin'
		echo '	}'
		echo '	if not'
		echo '		echo get9: could not bind selected Legmacs before /bin >[1=2]'
		echo '}'
		echo 'if not'
		echo '	echo get9: selected Legmacs is missing from $get9_legmacs_candidate_root >[1=2]'
		echo 'get9_legmacs_candidate_root=()'
		echo 'get9_legmacs_candidate_bin=()'
	} >$activetmp || fail could not write Legmacs activation
	cp $activetmp $get9_active || fail could not select Legmacs commit $source_commit
}

fn install_profile_hook {
	get9_profile_hooked=no
	if(test -f $userprofile) {
		if(grep -n '^# get9: profile hook$' $userprofile >/dev/null >[2]/dev/null)
			get9_profile_hooked=yes
	}

	if(~ $get9_profile_hooked no) {
		if(test -f $userprofile) {
			if(! test -e $profilebackup)
				cp -x $userprofile $profilebackup || fail could not back up $userprofile
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
				echo
				cat $userprofile
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		if not {
			{
				echo '# get9: profile hook'
				echo 'if(test -r $home/lib/get9/profile)'
				echo '	. $home/lib/get9/profile'
				echo '# get9: end profile hook'
			} >$userprofiletmp || fail could not prepare $userprofile
		}
		cp $userprofiletmp $userprofile || fail could not install profile hook
		echo get9: added the Get9 hook to $userprofile
	}
}

if(test -r $get9_profile)
	. $get9_profile

if(! ~ $cputype amd64)
	fail this Legmacs source recipe supports only Plan 9 amd64

if(! test -x /bin/lg) {
	echo get9: Legmacs requires LetGo >[1=2]
	echo get9: install it with: ports/let-go/main/source/amd64/install.rc >[1=2]
	fail lg is not active in this installer namespace
}

if(! test -x /bin/vt-alt) {
	echo get9: Legmacs requires VT-Alt >[1=2]
	echo get9: install it with: ports/vt-alt/main/source/amd64/install.rc >[1=2]
	fail vt-alt is not active in this installer namespace
}

mkdir -p $pkgbase $get9_root/tmp $get9_state/active $home/lib ||
	fail could not create Get9 directories
mkdir $work || fail could not create temporary directory $work

if(! test -e /mnt/web/clone) {
	echo get9: starting webfs
	webfs || fail could not start webfs
}

echo get9: cloning $source_url
git/clone $source_url $source || fail could not clone Legmacs

source_commit=`{cat $source/.git/refs/remotes/origin/main}
if(! ~ $#source_commit 1)
	fail could not resolve the cloned Legmacs main commit

head=`{cat $source/.git/HEAD}
checkout_commit=()
if(~ $#head 2) {
	if(~ $head(1) ref:)
		checkout_commit=`{cat $source/.git/$head(2)}
}
if not {
	if(~ $#head 1)
		checkout_commit=$head
}
if(! ~ $#checkout_commit 1)
	fail could not resolve the checked-out Legmacs commit
if(! ~ $checkout_commit $source_commit)
	fail git9 checked out $checkout_commit instead of Legmacs main $source_commit

pkgroot=$pkgbase/$source_commit
get9_already_installed=no
if(test -e $pkgroot) {
	if(! test -x $pkgroot/bin/legmacs)
		fail refusing to overwrite incomplete installation at $pkgroot
	if(! test -r $pkgroot/src/main.lg)
		fail refusing to reuse installation with missing Legmacs source at $pkgroot
	get9_already_installed=yes
}

if(~ $get9_already_installed no) {
	if(test -e $stage)
		fail refusing to overwrite staging directory $stage

	echo get9: validating Legmacs commit $source_commit with the active lg
	@{LG_SOURCE_PATHS=$source; cd $source && lg -c $bundle main.lg} ||
		fail Legmacs namespace compilation failed
	test -r $bundle || fail Legmacs namespace compilation did not produce a bundle
	rm $bundle

	mkdir $stage || fail could not create staging directory $stage
	get9_stage_owned=yes
	mkdir $stage/bin || fail could not create staging bin directory
	mkdir $stage/src || fail could not create staging source directory
	write_launcher
	mv $launcher $stage/bin/legmacs || fail could not stage Legmacs launcher
	rm -rf $source/.git
	dircp $source $stage/src || fail could not stage Legmacs source
	echo $source_url >$stage/source-url || fail could not record Legmacs source URL
	echo $source_commit >$stage/source-commit || fail could not record Legmacs source commit
	mv $stage $pkgroot || fail could not install Legmacs at $pkgroot
	get9_stage_owned=no
}

write_get9_profile
select_legmacs
install_profile_hook
cleanup

if(~ $get9_already_installed yes)
	echo get9: Legmacs commit $source_commit is already installed at $pkgroot
if not
	echo get9: installed Legmacs commit $source_commit at $pkgroot
echo get9: selected this Legmacs installation for future Drawterm connections
echo get9: reconnect with Drawterm to activate it everywhere
echo get9: to activate this window only, run: . $get9_profile
